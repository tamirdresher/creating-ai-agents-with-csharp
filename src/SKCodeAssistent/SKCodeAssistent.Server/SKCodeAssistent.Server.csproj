<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Agent Framework GA (replaces Semantic Kernel) -->
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />

    <!-- Microsoft.Extensions.AI abstractions -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />

    <!-- Azure OpenAI and raw OpenAI SDK -->
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="OpenAI" />

    <!-- MCP (Model Context Protocol) -->
    <PackageReference Include="ModelContextProtocol" />

    <!-- Agent-to-Agent (A2A) protocol -->
    <PackageReference Include="A2A" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SKCodeAssistent\SKCodeAssistent.ServiceDefaults\SKCodeAssistent.ServiceDefaults.csproj" />
  </ItemGroup>


</Project>
