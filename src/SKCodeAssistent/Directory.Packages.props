<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Semantic Kernel - latest stable -->
    <PackageVersion Include="Microsoft.SemanticKernel" Version="1.68.0" />
    <PackageVersion Include="Microsoft.SemanticKernel.Agents.Core" Version="1.68.0" />
    <PackageVersion Include="Microsoft.SemanticKernel.Agents.A2A" Version="1.68.0-alpha" />
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.AzureOpenAI" Version="1.68.0" />
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.68.0" />
    <!-- SK Preview orchestration packages (Magentic One, GroupChat, etc.) -->
    <PackageVersion Include="Microsoft.SemanticKernel.Agents.Magentic" Version="1.68.0-preview" />
    <PackageVersion Include="Microsoft.SemanticKernel.Agents.Orchestration" Version="1.68.0-preview" />
    <PackageVersion Include="Microsoft.SemanticKernel.Agents.Runtime.InProcess" Version="1.68.0-preview" />

    <!-- Microsoft Agent Framework (GA with .NET 10) - new unified AI agent framework -->
    <!-- https://github.com/microsoft/agent-framework -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.0.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.0.0" />
    <PackageVersion Include="Microsoft.Agents.AI.AzureAI" Version="1.0.0" />

    <!-- Microsoft.Extensions.AI - GA with .NET 10 (was preview in .NET 9) -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.4.0" />

    <!-- Azure AI -->
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageVersion Include="Azure.AI.Projects" Version="2.0.0" />
    <PackageVersion Include="Azure.Core" Version="1.49.0" />
    <PackageVersion Include="Azure.Identity" Version="1.20.0" />

    <!-- Model Context Protocol - now stable (1.x) -->
    <PackageVersion Include="ModelContextProtocol" Version="1.1.0" />

    <!-- Agent-to-Agent protocol -->
    <PackageVersion Include="A2A" Version="0.3.4-preview" />
    <PackageVersion Include="A2A.AspNetCore" Version="0.3.4-preview" />

    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.0.2" />
    <PackageVersion Include="Aspire.Hosting.Azure.AIFoundry" Version="13.0.2-preview.1.25603.5" />
    <PackageVersion Include="Aspire.Azure.AI.Inference" Version="13.0.2-preview.1.25603.5" />
    <PackageVersion Include="Aspire.Azure.AI.OpenAI" Version="13.0.2-preview.1.25603.5" />

    <!-- Microsoft.Extensions.* - .NET 10 GA -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.0.0" />

    <!-- ASP.NET Core - .NET 10 GA (was on 9 preview) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />

    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.14.0" />

    <!-- Misc -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>