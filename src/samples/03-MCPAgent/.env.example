# Required — your OpenAI (or compatible) API key
OPENAI_API_KEY=sk-...

# Model to use — gpt-4o, gpt-4o-mini, or any model supported by the endpoint
OPENAI_MODEL_ID=gpt-4o

# Optional — override the endpoint for GitHub Models, Azure OpenAI, etc.
OPENAI_ENDPOINT=

# Required for GitHub MCP server — your GitHub Personal Access Token
# Create one at https://github.com/settings/tokens (needs: repo, read:org)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...
