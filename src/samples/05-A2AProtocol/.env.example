# Required — your OpenAI (or compatible) API key
OPENAI_API_KEY=sk-...

# Model to use
OPENAI_MODEL_ID=gpt-4o

# Optional — override the endpoint
OPENAI_ENDPOINT=

# URL of a running A2A-compatible agent server
# Start 09-AgentWithAspire or any A2A server and point this at it
A2A_AGENT_URL=http://localhost:5000
