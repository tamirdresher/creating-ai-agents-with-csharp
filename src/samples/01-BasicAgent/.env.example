# Required — your OpenAI (or compatible) API key
OPENAI_API_KEY=sk-...

# Model to use — gpt-4o, gpt-4o-mini, or any model supported by the endpoint
OPENAI_MODEL_ID=gpt-4o

# Optional — override the endpoint for GitHub Models, Azure OpenAI, local Ollama, etc.
# GitHub Models: https://models.inference.ai.azure.com
# Azure OpenAI:  https://<your-resource>.openai.azure.com/openai
# Leave blank to use api.openai.com
OPENAI_ENDPOINT=
